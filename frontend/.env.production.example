# آدرس API در نسخه‌ی production.
# این مقدار در زمان build داخل باندل جا می‌گیرد؛ بعد از تغییر باید دوباره build کنید.
#
# اگر بک‌اند روی ساب‌دامین است:
REACT_APP_API_URL=https://api.example.com/api
#
# اگر بک‌اند زیر همان دامنه است:
# REACT_APP_API_URL=https://example.com/api

# آدرس نهایی سایت (برای canonical / og / sitemap)
REACT_APP_SITE_URL=https://example.com
